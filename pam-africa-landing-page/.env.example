# --- Public (safe in browser bundle) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local: http://localhost:3000 — Production: https://www.pamafrica.com
# Invite/reset emails use the live request host when deployed, even if this still says localhost.
NEXT_PUBLIC_BASE_URL=

# --- Server only — never prefix with NEXT_PUBLIC_ ---
# Used only in Next.js Route Handlers / server code. Not exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_SETUP_SECRET=

# Email (server only) — run npm run check:smtp after filling these
SMTP_HOST=mail.ai4africa.app
SMTP_PORT=587
SMTP_SECURE=false
# Set to false only for self-signed mail server TLS
SMTP_TLS_REJECT_UNAUTHORIZED=true
EMAIL_USER=support@pamafrica.com
EMAIL_PASS=
COMPANY_EMAIL=

# Sanity migration (remove after npm run migrate:sanity)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
SANITY_READ_TOKEN=
